# ==============================================================================
# SMART INVOICE & RECEIPT SCANNER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- LLM Provider Settings (Compatible with OpenAI, DeepSeek, OpenRouter, Ollama) ---
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60.0

# --- Alternative Provider Examples ---
# For DeepSeek:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL_NAME=deepseek-chat
#
# For Local Ollama:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL_NAME=llama3.1:8b
#
# For OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL_NAME=openai/gpt-4o-mini

# --- IBM Docling Engine Settings ---
DOCLING_TABLE_MODE=accurate        # "accurate" or "fast"
DOCLING_DO_OCR=true
DOCLING_OCR_ENGINE=rapidocr        # "rapidocr", "easyocr", or "tesseract"
DOCLING_CACHE_DIR=./storage/.cache/docling

# --- Storage & Folder Watcher (Paperless-ngx pattern) ---
STORAGE_CONSUME_DIR=./storage/consume
STORAGE_ARCHIVE_DIR=./storage/archive
STORAGE_ERROR_DIR=./storage/error
STORAGE_OUTPUT_DIR=./storage/output
WATCHER_POLL_INTERVAL=2.0
WATCHER_DEBOUNCE_SECONDS=3.0

# --- Downstream n8n & Webhooks ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook/invoices-ingest
WEBHOOK_TIMEOUT_SECONDS=15.0
ENABLE_EXCEL_EXPORT=true
ENABLE_JSON_EXPORT=true

# --- Web API Server ---
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
LOG_LEVEL=INFO
